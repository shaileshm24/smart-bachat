# SmartBachat AI Advisor Service Configuration

# Service settings
DEBUG=false

# Bachat Core Service URL
BACHAT_CORE_SERVICE_URL=http://localhost:8080

# JWT Configuration (must match other services)
JWT_SECRET=your-256-bit-secret-key-here-make-it-long-enough-for-hs256
JWT_ALGORITHM=HS256
JWT_ISSUER=smart-bachat

# ===========================================
# AI Provider Configuration
# ===========================================
# Which AI provider to use: "gemini" (recommended - free tier), "openai", or "auto"
# "auto" will try Gemini first, then OpenAI, then fallback
AI_PROVIDER=gemini
#AI_PROVIDER=openai - Use OpenAI only
#AI_PROVIDER=auto - Try Gemini first, then OpenAI, then fallback

# ===========================================
# Google Gemini Configuration (Recommended)
# ===========================================
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyBjoUIkSfSXNsU24EHdFi5gDSfU49UwqoM

# Gemini Model Selection:
# - "gemini-2.5-flash" (latest, fast, recommended)
# - "gemini-2.5-pro" (most accurate)
# - "gemini-2.0-flash" (stable)
GEMINI_MODEL=gemini-2.5-flash

# Temperature (0.0-1.0): Lower = more accurate
GEMINI_TEMPERATURE=0.3

# ===========================================
# OpenAI Configuration (Alternative)
# ===========================================
# ⚠️ REGENERATE THIS KEY - it was exposed publicly!
OPENAI_API_KEY=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
# Model Selection: "gpt-4o" (99% accuracy) or "gpt-4o-mini" (95% accuracy, cheaper)
OPENAI_MODEL=gpt-4o

# Temperature (0.0-1.0): Lower = more accurate
OPENAI_TEMPERATURE=0.3

# ===========================================
# Analysis Configuration
# ===========================================
DEFAULT_ANALYSIS_MONTHS=6
MIN_TRANSACTIONS_FOR_ANALYSIS=10

# Recommendation thresholds
HIGH_SPENDING_THRESHOLD_PERCENT=30.0
SAVINGS_POTENTIAL_THRESHOLD_PERCENT=10.0
